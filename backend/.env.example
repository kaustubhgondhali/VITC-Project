# ---------------------------------------------------------------------------
# VITC backend environment variables
# Copy to .env (or export in your shell / set in your server) before starting.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# DB_URL=jdbc:mysql://localhost:3306/vitc_db?useSSL=false&serverTimezone=Asia/Kolkata
# DB_USERNAME=root
# DB_PASSWORD=

# --- Razorpay (already used by the checkout) ------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Secret encryption / signing -------------------------------------------
# Master key for AES-256-GCM encryption of stored Razorpay/SMTP secrets, and
# the HMAC signing key for short-lived video access tokens. REQUIRED in any
# shared/production environment - without them a fixed, publicly-documented
# development-only key is used instead (fine on a laptop, never elsewhere).
# RAZORPAY_ENCRYPTION_KEY=
# VIDEO_TOKEN_SECRET=

# --- Default accounts seeded on first start ---------------------------------
# Local-dev-only defaults (admin/Admin@123, VITCteacher/VITC@123) are baked
# into application.properties for convenience. Override every one of these
# before deploying anywhere shared - application-prod.properties requires
# ADMIN_DEFAULT_PASSWORD / TEACHER_DEFAULT_PASSWORD explicitly and refuses to
# start without them.
# ADMIN_DEFAULT_USERNAME=admin
# ADMIN_DEFAULT_EMAIL=admin@vitc.in
# ADMIN_DEFAULT_NAME=Super Admin
# ADMIN_DEFAULT_PASSWORD=
# TEACHER_DEFAULT_USERNAME=VITCteacher
# TEACHER_DEFAULT_EMAIL=teacher@vitc.in
# TEACHER_DEFAULT_NAME=VITC Teacher
# TEACHER_DEFAULT_PASSWORD=

# --- Rate limiting (abuse protection) ---------------------------------------
# Sensible defaults are already set in application.properties; override only
# if you need different budgets for a specific environment.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# RATE_LIMIT_FORGOT_PASSWORD_MAX=3
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=600
# RATE_LIMIT_RESET_PASSWORD_MAX=5
# RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=600
# RATE_LIMIT_PUBLIC_WRITE_MAX=5
# RATE_LIMIT_PUBLIC_WRITE_WINDOW_SECONDS=600
# RATE_LIMIT_PAYMENT_MAX=10
# RATE_LIMIT_PAYMENT_WINDOW_SECONDS=600

# --- SMTP for student credential emails -----------------------------------
# Leave MAIL_HOST empty to switch email sending off (payments still work).
# Gmail example (use a Google App Password, not your account password):
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Visible sender details
MAIL_FROM=your-address@gmail.com
MAIL_FROM_NAME=VITC - Vertex IT Career
MAIL_SUPPORT_EMAIL=support@vitc.in

# Public URL of the Student Admin Login page (used as the button link in emails)
STUDENT_LOGIN_URL=http://localhost:5500/student-login.html

# Public base URL of the frontend site (absolute links in outgoing emails)
APP_FRONTEND_URL=http://localhost:5500

# --- SMTP settings encryption ----------------------------------------------
# Same AES-256-GCM master key already used to encrypt Razorpay secrets is
# reused to encrypt the SMTP password saved from Admin -> SMTP Settings.
# RAZORPAY_ENCRYPTION_KEY=

# --- Gmail via Google sign-in ("Connect Google Account", no App Password) ---
# Create an OAuth 2.0 client (type: Web application) in Google Cloud Console,
# enable the Gmail API, and add GOOGLE_REDIRECT_URI to its Authorized redirect URIs.
# Main Admin -> Email / SMTP Settings -> Connect Google Account then sends through Gmail.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/public/email/google/callback
